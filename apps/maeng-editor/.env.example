# maeng-editor 환경 변수 템플릿 (plan.md §B.5 — 키 이름만, 실제 값은 .env.local 에만 기입)
# 모든 키는 서버 전용이다. NEXT_PUBLIC_ 접두사를 절대 사용하지 않는다 (REQ-EDITOR-009).

# --- AWS S3 (마크다운/이미지 영속 — REQ-EDITOR-004/006) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_CLOUDFRONT_URL=

# S3 키 prefix — 실 버킷 read-only 조회로 확정 (2026-07-24, M4 pre-step):
#   실제 레이아웃: blog/markdowns/{category}/{fileName}.md / blog/images/{name}.{ext}
#   MARKDOWN prefix 는 markdowns/ 세그먼트 "앞" 조각이다 → 기본값 blog (미설정 시 자동 적용)
#   IMAGE prefix 는 이미지 폴더 전체 경로다        → 기본값 blog/images (미설정 시 자동 적용)
AWS_BUCKET_MARKDOWN_FOLDER_PREFIX=
AWS_BUCKET_IMAGE_FOLDER_PREFIX=

# --- OpenAI 보조 글쓰기 (REQ-EDITOR-007 — 모델명 하드코딩 금지) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- 로컬 블로그 미리보기 동기화 (REQ-EDITOR-008 capability gate — 미설정 시 기능 비활성) ---
# 예상 값: maeng-v2/apps/maeng-blog/content 의 절대 경로
BLOG_CONTENT_DIR=
