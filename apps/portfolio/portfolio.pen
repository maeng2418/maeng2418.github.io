                        {
                          "type": "frame",
                          "id": "R6o2Y",
                          "name": "Intro",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": "$spacing-xs",
                          "alignItems": "end",
                          "children": [
                            {
                              "type": "text",
                              "id": "ObwuN",
                              "name": "안녕하세요. 복잡한 문제를 해결하고 직관적인 경험을 만드는 프론트엔드 개발자, 김명성입니다.",
                              "fill": "#212121ff",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "안녕하세요. 레거시를 현대화하고, 공통 자산을 만들고, 팀이 코드를 짜는 방식을 설계하는 프론트엔드 개발자, 김명성입니다.",
                              "lineHeight": 1.5,
                              "fontFamily": "Pretendard",
                              "fontSize": 20,
                              "fontWeight": "600",
                              "letterSpacing": 0.2
                            },
                            {
                              "type": "text",
                              "id": "eDbZ3",
                              "name": "현재 놀유니버스 STAY FE팀에서, React와 Typescript를 사용해 복잡한 숙박업 도메인의 B2B 플랫폼을 만들고 있습니다.",
                              "fill": "#212121ff",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "현재 놀유니버스에서 React와 TypeScript로 글로벌 B2B 파트너 플랫폼을 만들며, 운영 서비스의 Vue → React 무중단 점진 전환(9차)과 사내 디자인시스템(공통 컴포넌트 15종+)을 주도했습니다.",
                              "lineHeight": 1.5,
                              "fontFamily": "Pretendard",
                              "fontSize": 20,
                              "fontWeight": "normal",
                              "letterSpacing": 0.2
                            },
                            {
                              "type": "text",
                              "id": "Oo99b",
                              "name": "복잡한 정책과 데이터를 사용자가 쉽고 직관적으로 이해할 수 있는 인터페이스로 설계하고, 효율적인 아키텍처와 개발 프로세스 개선을 통해 팀의 생산성에 기여하며, 지속 가능한 코드 베이스를 구축하고 있습니다.",
                              "fill": "#212121ff",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "계측 기반 성능 최적화(빌드 약 536배 단축)와 팀 AI 개발 인프라 표준화까지 — 구현을 넘어 의사결정의 근거를 남기는 개발을 지향합니다.",
                              "lineHeight": 1.5,
                              "fontFamily": "Pretendard",
                              "fontSize": 20,
                              "fontWeight": "normal",
                              "letterSpacing": 0.2
                            }
                          ]
                        }
                      ]
